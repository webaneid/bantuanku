# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/database

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
# Masa berlaku access token (default kode 15m). Produksi: 2h, lihat docs/decisions/adr-0012-masa-berlaku-access-token-2-jam.md
JWT_EXPIRES_IN=2h

# Email Service (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@bantuanku.org

# Payment Gateway - Midtrans
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# Payment Gateway - Xendit
XENDIT_SECRET_KEY=xnd_development_xxxxxxxxxxxxxxxxxxxxxx
XENDIT_IS_PRODUCTION=false

# Application Environment
ENVIRONMENT=development

# Jumlah proxy tepercaya di depan API untuk rate limit (entri ke-N dari kanan X-Forwarded-For).
# Nginx saja = 1; Cloudflare + Nginx = 2. Tanpa ini klien bisa melewati rate limit dengan memalsukan header.
# Cek konfigurasi proxy produksi dulu: nilai yang salah bisa mengunci banyak pengguna sekaligus.
# TRUSTED_PROXY_HOPS=

# Login/daftar Google (opsional). Tombol Google hanya tampil bila KEDUANYA terisi.
# Redirect URI yang didaftarkan di Google Cloud Console: {API_URL}/v1/auth/google/callback
# (override dengan GOOGLE_REDIRECT_URI bila API diakses lewat host/proxy yang berbeda)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# Secret HMAC webhook GOWA (X-Hub-Signature-256). WAJIB sama dengan secret di GOWA;
# tanpa ini endpoint /v1/whatsapp/webhook menolak semua request (503).
WHATSAPP_WEBHOOK_SECRET=

# Optional: Cloudflare Workers Bindings
# CACHE_KV_ID=your-kv-namespace-id
# STORAGE_R2_ID=your-r2-bucket-id
